# Vantra environment
#
# Copy this file to .env.local and fill in what you need. .env.local is git-ignored
# and is never sent to the browser. Only server code reads these values.

# ---- Founder access ----
# The co-founders' email addresses, comma separated. An account that signs up
# (or signs in) with one of these is marked as a founder automatically: every
# screen of its business, every plan's features, and the ability to switch plans
# from Dashboard → Subscription without paying. Server-side only.
# FOUNDER_EMAILS=founder1@example.com,founder2@example.com,founder3@example.com

# ---- Payments (Razorpay) ----
# Needed only to sell paid plans. Get them from Razorpay Dashboard → Settings →
# API Keys (Test mode keys work end to end for trying it out). Without them the
# plan buttons stay disabled and say payments are not connected.
#
# The webhook secret is the value you type when creating the webhook at
# Razorpay → Settings → Webhooks, pointing at /api/razorpay/webhook with the
# events subscription.activated, .charged, .cancelled, .halted, .completed
# and .expired. Paid plans are switched on only by that signed webhook.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional. Only for a stub or proxy in tests. Leave unset in normal use.
# RAZORPAY_API_BASE=https://api.razorpay.com

# ---- Security alerts (email) ----
# Refused sign-ins crossing a threshold inside a short window email the founders
# once, so nobody has to watch /dashboard/security by hand. Free on Brevo's
# transactional API: 300 emails a day, no card, one verified sender address is
# enough (no domain to buy). Without these two values alerts stay off and the
# security screen says so.
# BREVO_API_KEY=
# SECURITY_ALERT_FROM=

# Optional. Shown as the sender's name (default: Vantra).
# SECURITY_ALERT_FROM_NAME=Vantra

# Optional. Who gets the email. Defaults to FOUNDER_EMAILS when unset.
# SECURITY_ALERT_EMAILS=founder1@example.com,founder2@example.com

# Optional. Thresholds in plain numbers (defaults: 10 refusals in 10 minutes,
# at most one email every 60 minutes).
# SECURITY_ALERT_THRESHOLD=10
# SECURITY_ALERT_WINDOW_MINUTES=10
# SECURITY_ALERT_COOLDOWN_MINUTES=60

# Optional. Only for a proxy or a stub in tests. Leave unset in normal use.
# SECURITY_ALERT_API_BASE=https://api.brevo.com
# SECURITY_ALERT_APP_URL=https://brandmitra-u2gvs6.freebuff.site

# ---- AI copy (Phase 5) ----
# Free key from https://aistudio.google.com/apikey . Without it, the "Write with AI"
# panel explains the setup step and generates nothing.
GEMINI_API_KEY=

# Optional: pin a different free model (default: gemini-3.8-flash).
# Production is pinned to gemini-3.1-flash-lite: on 26 Nov 2026 the 3.5-3.8
# flash models kept answering 503 "experiencing high demand", while
# 3.1-flash-lite read a menu photo in ~5s and drafted copy correctly.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: the model tried once more when the first one refuses or hangs
# (default: gemini-3.1-flash-lite). A 503 or a timeout gets one more attempt
# within the same 20-second budget; a 429 does not, because another call cannot
# fix the key's own quota. Set it to the same value as GEMINI_MODEL to retry the
# same model instead of switching.
# GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# Optional: only for a proxy or staging endpoint that speaks the same
# /models/<model>:generateContent shape. Leave unset in normal use.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ---- WhatsApp Cloud API (optional) ----
# Without these, confirmations and reminders stay as one-tap wa.me links.
# With them, the front desk sends them itself. Step-by-step: docs/16-whatsapp-cloud-api.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional. Must match the placeholders in your approved templates:
# {{1}} customer's first name, {{2}} the day and time, {{3}} the business name.
# WHATSAPP_TEMPLATE_CONFIRMATION=booking_confirmation
# WHATSAPP_TEMPLATE_REMINDER=booking_reminder
# WHATSAPP_TEMPLATE_LANG=en

# Optional. Only needed for the scheduled sender described in docs/16.
# WHATSAPP_DISPATCH_SECRET=

# Optional. Graph host, for a proxy or a local stub. Leave unset in normal use.
# WHATSAPP_API_BASE=https://graph.facebook.com
