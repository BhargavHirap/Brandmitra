# Brandmitra environment
#
# Copy this file to .env.local and fill in what you need. .env.local is git-ignored
# and is never sent to the browser. Only server code reads these values.

# ---- AI copy (Phase 5) ----
# Free key from https://aistudio.google.com/apikey . Without it, the "Write with AI"
# panel explains the setup step and generates nothing.
GEMINI_API_KEY=

# Optional: pin a different free model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: only for a proxy or staging endpoint that speaks the same
# /models/<model>:generateContent shape. Leave unset in normal use.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
